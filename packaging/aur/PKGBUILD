# AUR package `beamlynx-bin`: https://aur.archlinux.org/packages/beamlynx-bin
# Published by hand from this folder; see packaging/README.md.
#
# Repackages the .deb release asset rather than building from source. The
# deb already ships electron-builder's FHS layout (/opt/beamlynx binary,
# .desktop file, hicolor icons). Layout checked against 0.20.0. The AUR
# requires the `-bin` suffix for a package that ships a prebuilt binary.
pkgname=beamlynx-bin
pkgver=0.20.0
pkgrel=1
pkgdesc="The database client that knows your schema"
arch=('x86_64')
url="https://beamlynx.com"
license=('LicenseRef-PolyForm-Noncommercial-1.0.0')
install="${pkgname}.install"
provides=('beamlynx')
conflicts=('beamlynx')
# Debian deps (control file of the .deb) mapped to Arch package names.
# libappindicator3-1 is a Recommends upstream (tray icon on some DEs), not a
# hard Depends -- kept optional here for the same reason.
depends=(
  'gtk3'
  'libnotify'
  'nss'
  'libxss'
  'libxtst'
  'xdg-utils'
  'at-spi2-core'
  'util-linux-libs'
  'libsecret'
)
optdepends=(
  'libayatana-appindicator: tray icon support'
)
# electron-builder's `dlopen`-based deps (libGLESv2.so etc.) ship inside
# /opt/beamlynx alongside the binary, same as upstream's deb -- not linked
# against the system, so no extra Depends needed for those.
options=('!strip')  # stripping Electron's prebuilt binaries is pointless and can break them
source=("https://github.com/beamlynx/beamlynx-desktop/releases/download/${pkgver}/beamlynx-${pkgver}.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/beamlynx/beamlynx-desktop/${pkgver}/LICENSE")
sha256sums=('34e11f86df29509d180c528b418dbe14b36f649b8db7ffa9505cad0a0997ae74'
            '9af73f790b39aaf892b4811dacd8750befe8e91e1176b15bb869a5d5e1120fb5')
noextract=("beamlynx-${pkgver}.deb")

package() {
  # bsdtar handles both the outer ar(1) .deb container and the inner
  # data.tar.xz in one step; equivalent to `ar x` + `tar xf data.tar.xz`.
  bsdtar -xf "${srcdir}/beamlynx-${pkgver}.deb" -C "${srcdir}" data.tar.xz
  bsdtar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"

  # The command is `beamlynx`, matching the package name. The deb creates
  # its symlink from postinst; on Arch it has to be a tracked file laid down
  # here instead, so it is removed with the package.
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/beamlynx/beamlynx-desktop "${pkgdir}/usr/bin/beamlynx"

  install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Deb's postinst decides the chrome-sandbox setuid bit at install time
  # based on the target machine's userns support; that's a kernel property
  # of the machine the package lands on, not of the build, so the actual
  # chmod happens in beamlynx-bin.install instead. This is just a safe
  # baseline in case the .install hook doesn't run for some reason.
  chmod 0755 "${pkgdir}/opt/beamlynx/chrome-sandbox"
}
