# Mirrors the setuid decision from the upstream .deb's postinst: chrome's
# sandbox only needs the setuid bit on systems without unprivileged user
# namespaces. Arch enables these by default, but this is a per-machine
# kernel property, not something PKGBUILD's package() can assume -- so it
# runs at install time, not build time.
_fix_sandbox() {
  if ! { [[ -L /proc/self/ns/user ]] && unshare --user true 2>/dev/null; }; then
    chmod 4755 /opt/beamlynx/chrome-sandbox 2>/dev/null || true
  fi
}

post_install() {
  _fix_sandbox
  update-desktop-database -q /usr/share/applications &>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor &>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q /usr/share/applications &>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor &>/dev/null || true
}
