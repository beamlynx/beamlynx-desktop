#!/usr/bin/env bash
# Runs Beamlynx from source, for development. `bin/beam` with no command
# lists the commands. Works from anywhere, including through a symlink such
# as ~/.local/bin/beam.
set -e

ROOT="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
PINE="$ROOT/pine"
UI="$ROOT/ui"
DESKTOP="$ROOT/desktop"
LOGS="${XDG_STATE_HOME:-$HOME/.local/state}/beamlynx/logs"

# The port the UI dev server listens on, and Electron loads in dev.
DEV_UI_PORT=3142
# The first Next.js compile is slow on a cold .next folder.
UI_READY_TIMEOUT=180

log() {
  echo " :: $(date -u +"%H:%M:%S") :: $1"
}

usage() {
  cat <<EOF
Usage: bin/beam <command>

See a change:
  dev            The desktop app, from source: the UI dev server with hot
                 reload, and Electron on top of it. Rebuilds the bundled Pine
                 server first when pine/ changed. Quitting the app stops both.
  web            The UI as a web page on http://localhost:$DEV_UI_PORT, with the
                 Pine server it needs. No Electron. Ctrl+C stops both.
  ui [--browser] Only the UI dev server, on port $DEV_UI_PORT. Desktop mode unless
                 --browser.
  desktop        Only Electron, against a UI dev server already running.
  api            Only the Pine server, on port 33333.

Data to try it on:
  sample-db      Build a small SQLite database to connect to in 'beam dev'.
  db [down|logs] Start the Postgres and MySQL test databases (needs Docker).

Check a change:
  check [pine|ui|desktop]
                 Run the tests and checks CI runs, for every part or one.

  kill           Stop stray dev processes left on the dev ports.

Logs: $LOGS
EOF
}

# Installs a folder's npm packages when they are missing, or older than its
# package-lock.json (after a pull that changed them). npm writes
# node_modules/.package-lock.json on every install.
ensure_npm() {
  local installed="$1/node_modules/.package-lock.json"
  if [ ! -f "$installed" ] || [ "$1/package-lock.json" -nt "$installed" ]; then
    log "Installing the npm packages in ${1#$ROOT/}/"
    (cd "$1" && npm ci)
  fi
}

# The UI pins its Node version in ui/.nvmrc, and CI uses that one. If this
# shell's Node is older and mise has the right one installed, use that.
# Otherwise say so: an older Node often works, but when something fails
# oddly, it is the first thing to rule out.
check_node() {
  local want have dir
  want=$(tr -dc '0-9' < "$UI/.nvmrc")
  have=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  [ "$have" -ge "$want" ] && return 0
  if command -v mise >/dev/null 2>&1; then
    dir=$(mise where "node@$want" 2>/dev/null || true)
    if [ -n "$dir" ] && [ -x "$dir/bin/node" ]; then
      export PATH="$dir/bin:$PATH"
      log "Using Node $want from mise (this shell has Node $have)"
      return 0
    fi
  fi
  log "Note: ui/.nvmrc asks for Node $want, and this shell has Node $have. If something fails oddly, switch (mise install node@$want, or nvm use in ui/)."
}

# Ports: the installed Beamlynx app runs its Pine server on 33333 (and its
# agent control plane on 33334). A desktop app run from source uses 43333 and
# 43334, so both can run side by side. 'beam api' uses 33333 too, so it can't
# run while the installed app is open.
cmd_kill() {
  local entry port desc pids pid
  for entry in "$DEV_UI_PORT:UI dev server" "9229:node inspector" "43333:dev app's Pine server" "43334:dev app's control plane" "5173:beamlynx.com dev server"; do
    port="${entry%%:*}"
    desc="${entry#*:}"
    pids=$(lsof -ti tcp:"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
      log "Stopping the $desc on port $port (pid $pids)"
      kill -9 $pids
    fi
  done
  # 33333 only when it is 'beam api' (Clojure), never the installed app.
  for pid in $(lsof -ti tcp:33333 2>/dev/null || true); do
    if ps -o args= -p "$pid" 2>/dev/null | grep -q clojure; then
      log "Stopping 'beam api' on port 33333 (pid $pid)"
      kill -9 "$pid"
    fi
  done
}

cmd_ui() {
  check_node
  ensure_npm "$UI"
  if [ "$1" = "--browser" ]; then
    log "Starting the UI as the web build"
  else
    log "Starting the UI in desktop mode (NEXT_PUBLIC_DESKTOP=1). It opens in a browser tab; 'beam dev' opens the real app."
    export NEXT_PUBLIC_DESKTOP=1
  fi
  cd "$UI"
  PORT=$DEV_UI_PORT npm run dev
}

cmd_api() {
  if lsof -ti tcp:33333 >/dev/null 2>&1; then
    echo "ERROR: something already listens on port 33333, probably the installed Beamlynx app. Quit it first." >&2
    exit 1
  fi
  log "Starting the Pine server on http://localhost:33333"
  cd "$PINE"
  clj -M:run-dev
}

# The UI as a web page, with the Pine server it talks to. Both stop together.
cmd_web() {
  check_node
  ensure_npm "$UI"
  if lsof -ti tcp:33333 >/dev/null 2>&1; then
    echo "ERROR: something already listens on port 33333, probably the installed Beamlynx app. Quit it first: the web page talks to Pine on that port." >&2
    exit 1
  fi
  mkdir -p "$LOGS"
  log "Starting the Pine server (log: $LOGS/api.log)"
  (cd "$PINE" && exec clojure -M:run-dev) > "$LOGS/api.log" 2>&1 &
  api_pid=$!
  # Stops this command's own Pine server, and nothing else.
  trap 'kill "$api_pid" 2>/dev/null || true; for p in $(lsof -ti tcp:33333 2>/dev/null); do ps -o args= -p "$p" | grep -q clojure && kill "$p"; done; true' EXIT INT TERM
  log "The page will be on http://localhost:$DEV_UI_PORT once both are up."
  log "Pine takes about 20 seconds to start. Connect to a database from the page, such as 'beam db' gives you."
  cd "$UI"
  PORT=$DEV_UI_PORT npm run dev
}

cmd_sample_db() {
  local target="${XDG_STATE_HOME:-$HOME/.local/state}/beamlynx/sample.db"
  mkdir -p "$(dirname "$target")"
  # node:sqlite needs Node 22 or later.
  if ! node -e 'require("node:sqlite")' 2>/dev/null; then
    echo "ERROR: building the database needs Node 22 or later. This shell has $(node -v)." >&2
    exit 1
  fi
  node "$DESKTOP/scripts/agent-case-db.mjs" "$target" >/dev/null
  log "Built $target"
  echo
  echo "Three tenants, five users, and their logins and exports."
  echo "In the app from 'beam dev': add a SQLite connection with this file."
  echo "It needs the desktop app: the web page can't open SQLite files."
}

cmd_check() {
  local part="${1:-all}" failed=""
  if [ "$part" = all ] || [ "$part" = pine ]; then
    log "Pine: format and tests (MySQL and Postgres tests run only with 'beam db' up; see pine/AGENTS.md)"
    (cd "$PINE" && clojure -M:fmt check && clojure -M:test) || failed="$failed pine"
  fi
  if [ "$part" = all ] || [ "$part" = ui ]; then
    check_node
    ensure_npm "$UI"
    log "UI: types and tests"
    (cd "$UI" && npm run type-check && npm test) || failed="$failed ui"
  fi
  if [ "$part" = all ] || [ "$part" = desktop ]; then
    ensure_npm "$DESKTOP"
    log "Desktop: build and tests"
    (cd "$DESKTOP" && npm test) || failed="$failed desktop"
  fi
  if [ -n "$failed" ]; then
    echo "FAILED:$failed" >&2
    exit 1
  fi
  log "All checks passed"
}

cmd_db() {
  cd "$PINE"
  case "$1" in
    down)
      log "Stopping the test databases"
      docker compose -f dev.docker-compose.yml down
      ;;
    logs)
      docker compose -f dev.docker-compose.yml logs -f
      ;;
    *)
      log "Starting the local Postgres and MySQL test databases (same tables, same seed data; see pine/DEV.md)"
      docker compose -f dev.docker-compose.yml up -d
      echo
      echo "Postgres: localhost:5435  (db pine, user pine, password pine)"
      echo "MySQL:    localhost:3308  (db pine, user pine, password pine)"
      echo
      echo "'beam db down' stops them, 'beam db logs' follows their logs."
      ;;
  esac
}

# Rebuilds what is behind the Pine source (jar, then app-image, then the copy
# staged in desktop/resources/server), so Electron never starts an old Pine.
stage_pine() {
  local jar="$PINE/target/pine-standalone.jar"
  local app_image="$PINE/desktop/build/app-image"
  local staged="$DESKTOP/resources/server"
  local rebuild_jar=false rebuild_app_image=false restage=false

  if [ ! -f "$jar" ] || [ -n "$(find "$PINE/src" -newer "$jar" -print -quit)" ]; then
    rebuild_jar=true
  fi
  if $rebuild_jar || [ ! -d "$app_image" ] || [ "$app_image" -ot "$jar" ]; then
    rebuild_app_image=true
  fi
  if $rebuild_app_image || [ ! -d "$staged" ] || [ "$staged" -ot "$app_image" ]; then
    restage=true
  fi
  $restage || return 0

  if $rebuild_jar; then
    log "Pine's source is newer than its jar, so the jar is rebuilt"
    rm -f "$jar"
  fi
  if $rebuild_app_image; then
    # jlink and jpackage output depends on the JDK: use the one
    # pine/desktop/JDK_VERSION pins.
    local jdk
    jdk=$(grep -v '^#' "$PINE/desktop/JDK_VERSION" | grep -v '^\s*$')
    if [ -z "$JAVA_HOME" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -q "version \"$jdk"; then
      JAVA_HOME="$(mise where "java@temurin-$jdk" 2>/dev/null || true)"
    fi
    if [ -z "$JAVA_HOME" ]; then
      echo "ERROR: JDK $jdk not found. Install it, for example: mise install java@temurin-$jdk" >&2
      exit 1
    fi
    export JAVA_HOME
    log "Building Pine's app-image with JDK $jdk ($JAVA_HOME)"
    (cd "$PINE" && ./desktop/build-app-image.sh)
  fi
  log "Staging the Pine server into desktop/resources/server"
  (cd "$DESKTOP" && ./scripts/stage-server.sh)
}

cmd_desktop() {
  ensure_npm "$DESKTOP"
  stage_pine
  # The Pine docs the app hands to AI agents. A quick copy.
  (cd "$DESKTOP" && ./scripts/stage-docs.sh >/dev/null)
  log "Starting the desktop app against http://localhost:$DEV_UI_PORT"
  [ -z "$BEAM_DEV" ] && log "The UI dev server must be running: 'beam ui' in another terminal."
  cd "$DESKTOP"
  BEAMLYNX_DEV_UI_URL="http://localhost:$DEV_UI_PORT" npm start
}

cmd_dev() {
  local ui_log="$LOGS/ui.log" ui_pid="" ui_pgid="" waited=0
  mkdir -p "$LOGS"
  check_node
  ensure_npm "$UI"
  ensure_npm "$DESKTOP"

  show_ui_log() {
    echo
    echo "Last lines of $ui_log:"
    tail -n 20 "$ui_log" 2>/dev/null || true
    echo
  }

  # Runs when the app quits, on Ctrl+C, and on any failure: the dev server
  # was started here, so it is stopped here.
  cleanup() {
    trap - EXIT INT TERM
    if [ -n "$ui_pgid" ] && kill -0 "-$ui_pgid" 2>/dev/null; then
      log "Stopping the UI dev server"
      kill -TERM "-$ui_pgid" 2>/dev/null || true
    elif [ -n "$ui_pid" ] && kill -0 "$ui_pid" 2>/dev/null; then
      log "Stopping the UI dev server"
      kill -TERM "$ui_pid" 2>/dev/null || true
    fi
    # `next dev` sometimes outlives its npm parent: whatever still holds the
    # port goes too.
    local stray
    stray=$(lsof -ti tcp:"$DEV_UI_PORT" 2>/dev/null || true)
    [ -n "$stray" ] && kill -9 $stray 2>/dev/null || true
  }
  trap cleanup EXIT INT TERM

  # Leftovers from an earlier run hold the ports this needs: the dev
  # server's, and 43333, where the dev app's Pine server refuses to start if
  # something else listens. The installed app (33333) is never touched.
  cmd_kill

  log "Starting the UI dev server in desktop mode (log: $ui_log)"
  : > "$ui_log"
  # In its own process group, so Ctrl+C reaches this script and Electron
  # first. cleanup stops the dev server after Electron is gone.
  local start="cd '$UI' && NEXT_PUBLIC_DESKTOP=1 PORT=$DEV_UI_PORT npm run dev"
  if command -v setsid >/dev/null 2>&1; then
    setsid bash -c "$start" >> "$ui_log" 2>&1 &
  else
    bash -c "$start" >> "$ui_log" 2>&1 &
  fi
  ui_pid=$!
  ui_pgid=$(ps -o pgid= -p "$ui_pid" 2>/dev/null | tr -d ' ' || true)
  # Only a separate group may be killed: our own would take this script down.
  [ "$ui_pgid" = "$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')" ] && ui_pgid=""

  log "Waiting for it on http://localhost:$DEV_UI_PORT (the first compile takes a while)"
  until curl -sf -o /dev/null "http://127.0.0.1:$DEV_UI_PORT/"; do
    if ! kill -0 "$ui_pid" 2>/dev/null; then
      echo "ERROR: the UI dev server stopped before it was ready." >&2
      show_ui_log
      exit 1
    fi
    if [ "$waited" -ge "$UI_READY_TIMEOUT" ]; then
      echo "ERROR: the UI dev server didn't answer within ${UI_READY_TIMEOUT}s." >&2
      show_ui_log
      exit 1
    fi
    sleep 2
    waited=$((waited + 2))
    [ $((waited % 20)) -eq 0 ] && log "Still waiting (${waited}s)"
  done
  log "The UI dev server is up"

  # In the foreground: when the app quits, cleanup stops the dev server.
  BEAM_DEV=1 cmd_desktop
}

# Every command that runs Node picks its version first.
case "$1" in
  dev|web|desktop|ui|sample-db|check) check_node ;;
esac

case "$1" in
  dev) cmd_dev ;;
  web) cmd_web ;;
  desktop) cmd_desktop ;;
  ui) cmd_ui "$2" ;;
  api) cmd_api ;;
  sample-db) cmd_sample_db ;;
  db) cmd_db "$2" ;;
  check) cmd_check "$2" ;;
  kill) cmd_kill ;;
  *) usage ;;
esac
